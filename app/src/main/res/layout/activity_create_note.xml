<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:padding="16dp"> <androidx.cardview.widget.CardView
    android:id="@+id/layoutCreateNote"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_above="@+id/btnCreer"
    android:layout_marginBottom="24dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    android:clipToOutline="true"> <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <EditText
        android:id="@+id/etTitre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Titre"
        android:inputType="text"
        android:textColor="#000000"
        android:textColorHint="#66000000"
        android:textSize="24sp"
        android:textStyle="bold"
        android:background="@null"
        android:paddingBottom="16dp" />

    <EditText
        android:id="@+id/etContenu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:hint="Contenu de la note..."
        android:gravity="top|start"
        android:inputType="textMultiLine"
        android:textColor="#000000"
        android:textColorHint="#66000000"
        android:textSize="16sp"
        android:background="@null" />
</LinearLayout>
</androidx.cardview.widget.CardView>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnCreer"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentBottom="true"
        android:text="Créer"
        android:textAllCaps="false"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="#000000" />

</RelativeLayout>