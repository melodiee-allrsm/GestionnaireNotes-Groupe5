<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <!-- Toolbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            app:title="Mes Notes"
            app:titleTextColor="#FFFFFF" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Contenu principal -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Zone de recherche textuelle + bouton favoris -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingTop="8dp"
            android:gravity="center_vertical">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutRecherche"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Rechercher par titre..."
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etRecherche"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:imeOptions="actionSearch"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Bouton Favoris : quand il est actif, on n'affiche que les notes favorites -->
            <Button
                android:id="@+id/btnFavoris"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="★ Favoris"
                android:backgroundTint="#BDBDBD"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

        </LinearLayout>
        <!-- Liste des notes -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="80dp" />

    </LinearLayout>

    <!-- Palette de couleurs (cachée par défaut) -->
    <LinearLayout
        android:id="@+id/layoutPalette"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:visibility="gone"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="80dp">

        <View android:id="@+id/colorVert"
            android:layout_width="40dp" android:layout_height="40dp"
            android:layout_margin="4dp"
            android:background="@drawable/circle_color"
            android:backgroundTint="@color/green" />

        <View android:id="@+id/colorRouge"
            android:layout_width="40dp" android:layout_height="40dp"
            android:layout_margin="4dp"
            android:background="@drawable/circle_color"
            android:backgroundTint="@color/red" />

        <View android:id="@+id/colorBleu"
            android:layout_width="40dp" android:layout_height="40dp"
            android:layout_margin="4dp"
            android:background="@drawable/circle_color"
            android:backgroundTint="@color/blue" />

        <View android:id="@+id/colorJaune"
            android:layout_width="40dp" android:layout_height="40dp"
            android:layout_margin="4dp"
            android:background="@drawable/circle_color"
            android:backgroundTint="@color/yellow" />

        <View android:id="@+id/colorOrange"
            android:layout_width="40dp" android:layout_height="40dp"
            android:layout_margin="4dp"
            android:background="@drawable/circle_color"
            android:backgroundTint="@color/orange" />

        <View android:id="@+id/colorGris"
            android:layout_width="40dp" android:layout_height="40dp"
            android:layout_margin="4dp"
            android:background="@drawable/circle_color"
            android:backgroundTint="@color/gray" />

    </LinearLayout>

    <!-- FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:contentDescription="Nouvelle note"
        app:srcCompat="@android:drawable/ic_input_add"
        app:backgroundTint="?attr/colorPrimary" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>