<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingBottom="12dp"
        android:paddingTop="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_search_bar"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp">

                <EditText
                    android:id="@+id/etRecherche"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:hint="🔍  Rechercher"
                    android:inputType="text"
                    android:textSize="15sp"
                    android:textColor="#000000"
                    android:textColorHint="#757575"
                    android:importantForAutofill="no"
                    android:imeOptions="actionSearch"/>
            </LinearLayout>

            <ImageView
                android:id="@+id/btnTri"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:padding="12dp"
                android:background="@drawable/bg_btn_tri"
                android:src="@android:drawable/ic_menu_sort_alphabetically"
                app:tint="#000000"
                android:contentDescription="Trier les notes" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnFavoris"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:text="Favoris"
                android:textAllCaps="false"
                android:textColor="#000000"
                android:textStyle="bold"
                android:textSize="14sp"
                android:paddingHorizontal="16dp"
                android:background="@drawable/bg_btn_favoris" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvCompteurNotes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 notes"
            android:textColor="#757575"
            android:textSize="15sp"
            android:textStyle="italic"
            android:layout_marginStart="12dp"
            android:layout_marginBottom="10dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="88dp" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvAucuneNote"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="Aucune notes"
        android:textColor="#757575"
        android:textSize="16sp"
        android:textStyle="normal"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/layoutPalette"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:visibility="gone"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="90dp">

        <View android:id="@+id/colorVert"
            android:layout_width="44dp" android:layout_height="44dp"
            android:layout_margin="4dp"
            android:background="@drawable/circle_color"
            android:backgroundTint="#219653" />
        <View android:id="@+id/colorRouge"
            android:layout_width="44dp" android:layout_height="44dp"
            android:layout_margin="4dp"
            android:background="@drawable/circle_color"
            android:backgroundTint="#EB5757" />
        <View android:id="@+id/colorBleu"
            android:layout_width="44dp" android:layout_height="44dp"
            android:layout_margin="4dp"
            android:background="@drawable/circle_color"
            android:backgroundTint="#2F80ED" />
        <View android:id="@+id/colorJaune"
            android:layout_width="44dp" android:layout_height="44dp"
            android:layout_margin="4dp"
            android:background="@drawable/circle_color"
            android:backgroundTint="#F2C94C" />
        <View android:id="@+id/colorOrange"
            android:layout_width="44dp" android:layout_height="44dp"
            android:layout_margin="4dp"
            android:background="@drawable/circle_color"
            android:backgroundTint="#F2994A" />
        <View android:id="@+id/colorGris"
            android:layout_width="44dp" android:layout_height="44dp"
            android:layout_margin="4dp"
            android:background="@drawable/circle_color"
            android:backgroundTint="#828282" />
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:contentDescription="Nouvelle note"
        app:srcCompat="@android:drawable/ic_input_add"
        app:tint="#FFFFFF"
        app:backgroundTint="#000000"
        app:fabSize="normal" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>