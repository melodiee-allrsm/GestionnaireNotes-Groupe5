<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:padding="16dp">

    <androidx.cardview.widget.CardView
        android:id="@+id/layoutEditNote"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/btnSauvegarderEdit"
        android:layout_marginBottom="24dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        android:clipToOutline="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="20dp">

            <ImageView
                android:id="@+id/btnRetourEdit"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:padding="12dp"
                android:src="@android:drawable/ic_menu_revert"
                android:contentDescription="Retour"
                app:tint="#000000"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true" />

            <EditText
                android:id="@+id/etTitreEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Titre"
                android:textColor="#000000"
                android:textColorHint="#66000000"
                android:textSize="24sp"
                android:textStyle="bold"
                android:background="@null"
                android:paddingBottom="16dp" />

            <EditText
                android:id="@+id/etContenuEdit"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="Contenu de la note..."
                android:textColor="#000000"
                android:textColorHint="#66000000"
                android:textSize="16sp"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:background="@null" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnSauvegarderEdit"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentBottom="true"
        android:text="Modifier"
        android:textAllCaps="false"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="#000000" />

</RelativeLayout>